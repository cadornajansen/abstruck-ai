# Add missing entries to apps/web/.env.local. Do not overwrite existing values.
# Never commit .env.local or paste credentials into documentation/chat.

# Auth email callbacks; the localhost default is used when unset.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase development project. Only these two values are browser-visible.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server/worker configuration. Use the same intended development project.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# OpenAI project key for feasibility and study operations.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-6-luna
# Fresh environments stay off; local acceptance passed. See docs/chat-grounding-delivery.md.
OPENAI_CHAT_WEB_SEARCH_VERIFIED=false
ASSESSMENT_AI_ATTEMPTS_PER_SET=3

# Server-only key for creating/copying private share links. Use random 32+ bytes.
SHARE_TOKEN_SECRET=

# Private R2 development bucket; scoped Object Read & Write credentials.
# Keep public bucket access disabled. CORS example: config/r2-cors.local.json.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Local deployment tooling only; do not inject into the web or worker runtime.
# Railway project token scoped to the intended development environment.
RAILWAY_TOKEN=

# Requested in later setup batches; leave empty until that integration starts.
ASSEMBLYAI_API_KEY=
ASSEMBLYAI_WEBHOOK_URL=
ASSEMBLYAI_WEBHOOK_SECRET=
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
RESEND_API_KEY=
EMAIL_FROM=

# Founder/support configuration. Set real values only in ignored .env.local.
ABSTRUCK_ADMIN_USER_IDS=
SUPPORT_EMAIL=

# Opt-in renewal notices and daily founder digest. Enables real email delivery.
MAINTENANCE_NOTIFICATIONS_ENABLED=false

# Local backup CLI only; never inject the DB password or encryption key into clients.
SUPABASE_DB_URL=
DATABASE_BACKUP_KEY=
# Optional overrides; checked-in public provider CA and native PostgreSQL path are defaults.
SUPABASE_DB_CA_FILE=
PG_BIN=
