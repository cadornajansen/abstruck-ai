{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["VERCEL_ENV", "POLAR_ENVIRONMENT", "POLAR_PRODUCT_ID", "POLAR_ORGANIZATION_ID"],
      "passThroughEnv": ["POLAR_ACCESS_TOKEN", "POLAR_WEBHOOK_SECRET"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "format": {
      "dependsOn": ["^format"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "dev": {
      "passThroughEnv": ["LOCAL_PRICING_COUNTRY", "LOCAL_POLAR_SANDBOX_PORT"],
      "cache": false,
      "persistent": true
    }
  }
}
